# Copy to .env and paste your own key. One key per student.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Optional: override the model. The default is set in triage.py. Pick one that honors
# temperature; gemini-3.5-flash-lite does not.
# GEMINI_MODEL=gemini-2.5-flash-lite
